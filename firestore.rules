rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'coinpips0@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'membership']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'membership', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 120 &&
        data.membership in ['free', 'vip'] &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 80)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['id', 'userId', 'userEmail', 'subject', 'message', 'status']) &&
        data.keys().hasOnly(['id', 'userId', 'userEmail', 'subject', 'message', 'category', 'status', 'createdAt']) &&
        data.id is string && data.id.size() <= 64 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.userEmail is string && data.userEmail.size() <= 120 &&
        data.subject is string && data.subject.size() <= 120 &&
        data.message is string && data.message.size() <= 1000 &&
        data.status in ['open', 'in_progress', 'resolved'] &&
        (!('category' in data) || (data.category is string && data.category.size() <= 40)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidWatchlistItem(data) {
      return data.keys().hasAll(['userId', 'symbol', 'name', 'assetClass']) &&
        data.keys().hasOnly(['userId', 'symbol', 'name', 'assetClass', 'addedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.symbol is string && data.symbol.size() <= 32 &&
        data.name is string && data.name.size() <= 80 &&
        data.assetClass in ['crypto', 'forex', 'stock', 'indices', 'commodities'] &&
        (!('addedAt' in data) || (data.addedAt is string && data.addedAt.size() <= 64));
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isAdmin();

      // User Watchlist Subcollection
      match /watchlist/{symbol} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(symbol) && isValidWatchlistItem(incoming());
        allow delete: if isOwner(userId) && isValidId(symbol);
      }
    }

    // Market Signals
    match /signals/{signalId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Support Tickets
    match /supportTickets/{ticketId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(ticketId) && isValidSupportTicket(incoming());
      allow update: if isSignedIn() && isValidId(ticketId) && (isAdmin() || (existing().userId == request.auth.uid && isValidSupportTicket(incoming())));
      allow delete: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
